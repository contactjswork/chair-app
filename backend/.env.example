APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Emails ──────────────────────────────────────────────────────────────
# Six emails passent par ces variables, dont la RÉINITIALISATION DE MOT DE
# PASSE : tant que ce bloc n'est pas rempli avec un vrai serveur SMTP, aucun
# email ne part et personne ne peut récupérer son compte.
#
# Procédure pas à pas par fournisseur (où lire chaque valeur, DNS SPF/DKIM/
# DMARC, vérification) : docs/app-store/ACTION_GERANT_SMTP.md
# Vue d'ensemble des emails et de leurs déclencheurs : docs/EMAILS.md
#
# Vérifier la configuration en une commande, sans rien envoyer :
#   php artisan config:clear && php artisan chair:test-mail
# Envoyer un exemplaire de chaque email pour contrôler le rendu :
#   php artisan chair:test-mail votre-adresse@exemple.fr

# smtp en production. 'log' écrit les emails dans storage/logs/laravel.log
# au lieu de les envoyer — pratique en local pour relire un rendu.
MAIL_MAILER=smtp

# Serveur SMTP du fournisseur — valeurs À RECOPIER depuis son interface,
# jamais à deviner. Exemples de FORMAT attendu :
#   MAIL_HOST=smtp.mon-fournisseur.tld
#   MAIL_PORT=587    (STARTTLS)  ou  465 (SSL)
#   MAIL_ENCRYPTION=tls          ou  ssl
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls

# Identifiants SMTP. NE JAMAIS COMMITTER DE VRAIE VALEUR ICI : ce fichier est
# suivi par git, seul backend/.env (ignoré par git) contient les vrais secrets.
# MAIL_USERNAME est souvent l'adresse email complète (Infomaniak) ou un login
# fourni par le service d'envoi (Brevo) — voir ACTION_GERANT_SMTP.md.
MAIL_USERNAME=
MAIL_PASSWORD=

# Adresse d'expédition : doit être une adresse RÉELLE du domaine, autorisée
# chez le fournisseur, sinon les messages sont rejetés ou classés en spam.
# À figer une fois pour toutes (changer d'expéditeur abîme la délivrabilité).
MAIL_FROM_ADDRESS=
# Nom affiché comme expéditeur dans la boîte du destinataire.
MAIL_FROM_NAME=CHAIR

# Base de TOUS les liens contenus dans les emails (lien de réinitialisation de
# mot de passe, lien d'avis certifié, boutons). Sans elle, les liens pointent
# sur http://localhost:3000 et sont morts pour le destinataire.
# Domaine canonique : www, l'apex redirige (308).
FRONTEND_URL=https://www.getchair.app

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Notifications push APNs natives (aucun SDK tiers).
# Clé APNs : portail Apple Developer > Certificates, Identifiers & Profiles >
# Keys > + > cocher "Apple Push Notifications service (APNs)". Télécharger le
# fichier .p8 (une seule fois !) et le poser HORS webroot, jamais dans Git.
# Sur Infomaniak : par ex. /home/clients/<id>/keys/AuthKey_XXXXXXXXXX.p8
# KEY_ID = identifiant de la clé (visible dans la liste des Keys),
# TEAM_ID = en haut à droite du portail (Membership).
# APNS_ENVIRONMENT : production (TestFlight ET App Store) | sandbox (builds Xcode).
# Diagnostic complet : php artisan chair:test-push {email}
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.getchair.client
APNS_BUNDLE_ID_PRO=app.getchair.pro
APNS_ENVIRONMENT=production

# Accès admin (Bearer statique) — générer avec `php -r "echo bin2hex(random_bytes(32));"`.
# Sans valeur (ou avec l'ancienne valeur de démo), /admin/* refuse toute requête.
ADMIN_API_TOKEN=

# CHAIR+ / CHAIR BUSINESS — https://dashboard.stripe.com (mode test d'abord)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CHAIR_PLUS=
STRIPE_PRICE_CHAIR_BUSINESS=

# Achat integre Apple (CHAIR+ dans le binaire CHAIR PRO iOS)
# Cle secrete partagee : App Store Connect > CHAIR PRO > Informations > Cle secrete partagee
APPLE_IAP_SHARED_SECRET=
# Identifiant du produit d abonnement cree dans App Store Connect (defaut du code si vide)
APPLE_IAP_PRODUCT_CHAIR_PLUS=app.getchair.pro.chairplus.monthly

# ── Authentification ────────────────────────────────────────────────────
# Durée de vie d'un jeton d'API Sanctum, EN MINUTES (43200 = 30 jours).
# Les jetons vivent dans le localStorage d'une WebView iOS : sans expiration,
# un téléphone perdu ou revendu garde un accès permanent au compte.
# Expiration ABSOLUE, comptée depuis la création du jeton (Sanctum ne fait pas
# de renouvellement glissant) : l'utilisateur se reconnecte tous les 30 jours.
# Mettre 0 pour revenir à des jetons sans expiration (dépannage uniquement).
SANCTUM_TOKEN_EXPIRATION=43200

# Adresse de contact publiée (formulaire de contact, mentions légales,
# signalements). Doit rester identique à SUPPORT_EMAIL dans
# frontend/lib/contact.ts. Cette boîte doit être relevée par un humain
# (App Store Review Guideline 1.2).
SUPPORT_ADDRESS=hello@getchair.app

# Jeton du déclencheur de tâches planifiées (hébergement mutualisé : le
# planificateur Infomaniak ne sait appeler que des URL, pas des commandes).
# Générer une valeur longue et aléatoire :
#   php -r "echo bin2hex(random_bytes(24));"
# Sans cette variable, la route /scheduler/run répond 404 (désactivée).
SCHEDULER_TOKEN=
