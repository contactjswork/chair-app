<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>fr</string>
	<key>CFBundleDisplayName</key>
        <string>CHAIR</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!-- CHAIR n'a pas de thème sombre : tout le site est en blanc
	     (body bg-white). Sans ce réglage, l'app suivait le thème du système,
	     et sur un iPhone en mode sombre l'écran de lancement s'affichait en
	     NOIR — puis le site arrivait en blanc. D'où l'écran noir figé au
	     démarrage, le temps que la WebView charge le site distant.
	     Forcer l'apparence claire aligne l'écran de lancement, la barre
	     d'état et toute l'interface système sur le contenu réellement
	     affiché. À retirer le jour où un thème sombre existera côté web. -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>CHAIR utilise l'appareil photo pour te laisser prendre ta photo de profil directement depuis l'app.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>CHAIR accède à tes photos pour te laisser choisir ta photo de profil dans ta galerie.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>CHAIR utilise ta position pour te montrer les coiffeurs les plus proches de toi.</string>
</dict>
</plist>
